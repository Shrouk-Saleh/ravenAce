# Frontend environment variables (copy to .env and fill in values)
# In production (Render), these are NOT needed — relative URLs are used automatically.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# The callback URL for the HireHub integration to return to after linking
VITE_HIREHUB_CALLBACK_URL=http://localhost:3000/callback
